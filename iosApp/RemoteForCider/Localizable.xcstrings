{
  "sourceLanguage": "en",
  "strings": {
    "Already have a token?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya tienes un token?"
          }
        }
      }
    },
    "Can't reach Cider": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con Cider"
          }
        }
      }
    },
    "Cider denied the request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cider rechazó la solicitud."
          }
        }
      }
    },
    "Cider is busy. Try again in a few seconds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cider está ocupado. Vuelve a intentarlo en unos segundos."
          }
        }
      }
    },
    "Cider will ask you on the computer to allow Remote for Cider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cider te pedirá en el PC que permitas Remote for Cider."
          }
        }
      }
    },
    "Computer address (e.g. 192.168.0.110)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección del PC (p. ej. 192.168.0.110)"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando…"
          }
        }
      }
    },
    "Couldn't reach Cider: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Cider: %@"
          }
        }
      }
    },
    "Forget this computer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidar este PC"
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio"
          }
        }
      }
    },
    "Install the bridge on your computer first: Cider only listens on the computer itself. The bridge uses port 10768.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala antes el puente en el PC: Cider solo escucha en el propio PC. El puente usa el puerto 10768."
          }
        }
      }
    },
    "Library": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca"
          }
        }
      }
    },
