      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo"
          }
        }
      }
    },
    "Nobody answered in Cider within 2 minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie respondió en Cider en 2 minutos."
          }
        }
